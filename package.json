{
  "name": "fcp-audit",
  "version": "0.0.0",
  "description": "fcp-audit",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development npm run server:watch",
    "dev:debug": "NODE_ENV=development npm run server:debug",
    "docker:build": "docker compose build",
    "docker:dev": "docker compose up",
    "git:pre-commit-hook": "npm run lint:fix",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "npm run setup:husky",
    "server:debug": "node --inspect-brk=0.0.0.0 --watch-path=./src ./src/index.js",
    "server:watch": "node --inspect=0.0.0.0 --watch-path=./src ./src/index.js",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node --use-strict .",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "docker:test": "npm run lint && mkdir -p -m 755 coverage 2>/dev/null || true && docker compose -p fcp-audit-test down -v && docker compose -f compose.yml -f compose.test.yml run --build --rm fcp-audit",
    "docker:test:watch": "docker compose -p fcp-audit-test down -v && docker compose -f compose.yml -f compose.test.yml -f compose.test.watch.yml run --build --rm fcp-audit"
  },
  "author": "Defra DDTS",
  "contributors": [
    "John Watson <john.watson1@defra.gov.uk>"
  ],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-sns": "3.1125.0",
    "@aws-sdk/client-sqs": "3.1036.0",
    "@defra/cdp-auditing": "0.6.2",
    "@defra/fcp-audit-publisher": "1.0.12",
    "@defra/hapi-tracing": "1.22.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.2",
    "@hapi/jwt": "3.2.4",
    "@hapi/vision": "7.0.3",
    "apiv": "1.4.1",
    "aws-embedded-metrics": "4.2.0",
    "aws4": "1.13.2",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "global-agent": "4.1.3",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "hapi-swagger": "17.3.2",
    "joi": "17.13.8",
    "mongodb": "6.20.0",
    "pino": "10.0.0",
    "pino-pretty": "13.0.0",
    "qs": "6.16.0",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.29.0",
    "husky": "9.1.7",
    "neostandard": "0.12.1",
    "vitest": "4.1.11"
  }
}
